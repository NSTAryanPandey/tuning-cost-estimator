# Leave both empty to use the bundled sample data (no database needed).
SUPABASE_URL=
# Supabase → Project Settings → API → service_role key. Server only: never put this in the frontend or GitHub.
SUPABASE_SERVICE_KEY=
# Comma-separated list of frontend URLs allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
# Long random string used to sign login tokens. REQUIRED in production.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
